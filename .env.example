# Database
DATABASE_URL=

# Used by docker-compose.yml to initialize the Postgres container (must match DATABASE_URL above)
POSTGRES_USER=darsyria
POSTGRES_PASSWORD=
POSTGRES_DB=darsyria

# Application
APP_ENV=development
SECRET_KEY=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Magic link. In production set FRONTEND_URL to your real site, e.g. https://darsyria.com
MAGIC_LINK_EXPIRATION_MINUTES=15
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins, e.g. https://darsyria.com,https://www.darsyria.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Production deploy (docker compose --profile prod) ───────────────────────
# Your domain. Caddy serves the apex (frontend) and api.<domain> (API) with
# automatic HTTPS. DNS for both must point at the server; ports 80/443 open.
SITE_DOMAIN=
# Browser-facing URLs (also passed as frontend build args by compose). In prod:
#   NEXT_PUBLIC_SITE_URL=https://<SITE_DOMAIN>
#   NEXT_PUBLIC_API_URL=https://api.<SITE_DOMAIN>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Remember in production: APP_ENV=production (enables Secure cookies),
# FRONTEND_URL + ALLOWED_ORIGINS = your https domain(s).

# Chat LLM — any OpenAI-compatible provider. The code posts to
# {LLM_BASE_URL}/chat/completions, so switching providers is env-only.
# Example (Groq, free, OpenAI-compatible):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Legacy Ollama vars (deprecated). Still read as a fallback if LLM_* are unset,
# but note the request is now OpenAI-format, so OLLAMA_API_URL must point at an
# OpenAI-compatible base (e.g. Ollama's /v1 endpoint), not the native /api one.
# OLLAMA_API_URL=
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma2:27b

# RAG / Embeddings
ARTICLE_SOURCE_DIR=content/articles
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Transactional email and buyer-seller relay. Configure mail.<domain> as a
# Resend receiving domain and subscribe this signed endpoint to email.received,
# email.sent, email.delivered, email.delivery_delayed, email.failed, and
# email.bounced: https://api.<domain>/webhooks/resend
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=DarSyria
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=mail.darsyria.me
REPLY_TOKEN_TTL_DAYS=365
INBOUND_EVENT_RETENTION_DAYS=14

# Sentry error monitoring (optional). Leave SENTRY_DSN empty to disable.
# Get the DSN from your Sentry project settings; set it only in production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Separate NON-public R2 bucket for sensitive verification documents (deeds,
# IDs, business licenses). Strongly recommended in production: create a bucket
# WITHOUT public access and put its name here. If left empty, documents go in
# the main bucket and rely only on unguessable keys (reachable via the public
# bucket domain if a key leaks).
R2_PRIVATE_BUCKET_NAME=
